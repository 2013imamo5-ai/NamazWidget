<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ImageView
        android:id="@+id/widget_picture"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="fitXY"
        android:contentDescription="Расписание намаза на сегодня" />

    <!-- Chronometer is updated by the Android framework every second, not by repeated bitmap redraw. -->
    <Chronometer
        android:id="@+id/countdown_top"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|end"
        android:layout_marginTop="7dp"
        android:layout_marginEnd="13dp"
        android:fontFamily="sans-serif-medium"
        android:textColor="#E7C982"
        android:textSize="11sp"
        android:singleLine="true"
        android:includeFontPadding="false" />

    <Chronometer
        android:id="@+id/countdown_bottom"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_marginBottom="9dp"
        android:layout_marginEnd="15dp"
        android:fontFamily="sans-serif-medium"
        android:textColor="#E7C982"
        android:textSize="12sp"
        android:singleLine="true"
        android:includeFontPadding="false" />
</FrameLayout>
